<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service for keeping the session alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Post the ongoing/completion notifications (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact final-bell alarm. SCHEDULE_EXACT_ALARM is user-grantable via Settings on Android 12+. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Optional Phase 2 reboot recovery. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Battery-optimization info screen (we only inform; we never claim guaranteed exemption). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MeditationApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeditationTimer">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MeditationTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authoritative session engine host. mediaPlayback type: continuous audio + reliable
             interval events survive screen-off. Started from the foreground Start action. -->
        <service
            android:name=".service.MeditationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Final-bell fallback: fires even if the service is evicted from memory. -->
        <receiver
            android:name=".alarm.FinalAlarmReceiver"
            android:exported="false" />

        <!-- Notification-action relay (Pause/Resume, Add 5, Finish) without opening the activity. -->
        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false" />

        <!-- Optional Phase 2: reschedule future completion alarms after reboot. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
